@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Patient Feedback</title>
    <link rel="stylesheet" href="~/css/opd-feedback.css" asp-append-version="true" />
</head>

<body>
    <div class="app-container">
        <div class="phone-frame">

            <!-- HEADER (always visible, even after submit) -->
            <div class="header">
                <div class="header-left">
                    <h1 id="formTitle">Loading...</h1>
                    <p id="subTitle">Submit your feedback</p>
                </div>
                <div class="badge-active" id="statusBadge">
                    Active
                </div>
            </div>

            <div id="formBody">

                <div class="info-section-label">Patient &amp; Visit Details</div>
                <div class="info-grid">

                    <div class="info-col">
                        <div class="info-item">
                            <label>CR Number</label>
                            <strong id="crNumber">-</strong>
                        </div>

                        <div class="info-item">
                            <label>Doctor</label>
                            <strong id="doctorName">-</strong>
                        </div>

                        <div class="info-item ipd-only" style="display:none;">
                            <label>Class</label>
                            <strong id="className">-</strong>
                        </div>
                    </div>

                    <div class="info-col">
                        <div class="info-item">
                            <label id="regLabel">Registration No.</label>
                            <strong id="registrationCode">-</strong>
                        </div>

                        <div class="info-item">
                            <label id="dateLabel">Date</label>
                            <strong id="registrationDate">-</strong>
                        </div>

                        <div class="info-item ipd-only" style="display:none;">
                            <label>Discharge Date</label>
                            <strong id="dischargeDate">-</strong>
                        </div>
                    </div>
                </div>
                <!-- QUESTIONS -->
                <div class="content">
                    <div id="questionContainer"></div>
                </div>

                <!-- always render textarea containers safely -->
                <div id="dynamicTextSections"></div>

                <!-- FOOTER -->
                <div class="footer">
                    <button class="submit-btn" id="submitBtn">Submit Feedback</button>
                </div>

            </div>

            <!-- POST-SUBMIT CONFIRMATION (Google Forms style), shown in place of formBody, below the header -->
            <div class="success-screen" id="successScreen" style="display:none;">
                <div class="success-icon">
                    <svg viewBox="0 0 52 52" width="56" height="56">
                        <circle class="success-icon-circle" cx="26" cy="26" r="25" fill="none" />
                        <path class="success-icon-check" fill="none" d="M14 27l7 7 17-17" />
                    </svg>
                </div>
                <h2 class="success-title">Your feedback submitted successfully</h2>
                <p class="success-subtext">Thank you for taking the time to share your feedback with us.</p>
            </div>

        </div>
    </div>

    <script>
        function resolveOptionText(opt) {
            return opt.type ?? opt.code ?? opt.optionText ?? opt.label ?? "";
        }

        function formatDate(dateString) {
            if (!dateString) return "-";
            const date = new Date(dateString);

            const day = String(date.getDate()).padStart(2, "0");
            const month = date.toLocaleString("en-GB", { month: "short" });
            const year = date.getFullYear();

            return `${day}/${month}/${year}`;
        }
        document.addEventListener("DOMContentLoaded", async () => {

            try {

                const params = new URLSearchParams(window.location.search);

                const token = params.get("t") || params.get("token");

                window.feedbackToken = token;

                if (!token) {
                    document.getElementById("submitBtn").disabled = true;
                    alert("Invalid feedback link.");
                    return;
                }

                const tokenResponse = await fetch(`/api/token/ResolveToken?token=${encodeURIComponent(token)}`);

                if (!tokenResponse.ok) {
                    document.getElementById("submitBtn").disabled = true;
                    throw new Error("This feedback link is invalid or has expired.");
                }

                const tokenData = await tokenResponse.json();

                const patientId = tokenData.patientId;
                const registrationId = tokenData.registrationId;
                const flag = tokenData.opdIpdFlag;

                window.patientId = patientId;
                window.registrationId = registrationId;
                window.flag = flag;

                const isIpd = flag === 1;

                document.getElementById("formTitle").innerText =
                    isIpd ? "IPD Feedback" : "OPD Feedback";

                document.getElementById("statusBadge").innerText =
                    isIpd ? "Admitted" : "Active";

                const res = await fetch(
                    `/api/PatientFeedback/feedback?token=${encodeURIComponent(token)}`
                );

                if (!res.ok) {
                    document
                        .querySelectorAll("button,textarea")
                        .forEach(x => x.disabled = true);

                    let serverMessage = "";
                    try {
                        const errBody = await res.json();
                        serverMessage = errBody.message || errBody.Message || "";
                    } catch { /* response wasn't JSON */ }

                    throw new Error(
                        serverMessage
                            ? `Unable to load feedback: ${serverMessage}`
                            : `Unable to load feedback (HTTP ${res.status}).`
                    );
                }

                const data = await res.json();

                window._feedbackData = data;

                document.getElementById("crNumber").innerText =
                    data.crNumber || "-";

                document.getElementById("doctorName").innerText =
                    data.doctorName || "-";

                document.getElementById("registrationCode").innerText =
                    isIpd
                        ? data.ipdRegistrationCode || "-"
                        : data.registrationCode || "-";

                document.getElementById("registrationDate").innerText =
                    isIpd
                        ? formatDate(data.admissionDateTime)
                        : formatDate(data.registrationDate);

                if (isIpd) {

                    document.querySelectorAll(".ipd-only")
                        .forEach(x => x.style.display = "flex");

                    document.getElementById("regLabel").innerText = "IPD Number";

                    document.getElementById("dateLabel").innerText = "Admission Date";

                    document.getElementById("className").innerText =
                        data.className || "-";

                    document.getElementById("dischargeDate").innerText =
                        data.dischargeDate
                            ? formatDate(data.dischargeDate)
                            : "-";
                }
                else {

                    document.querySelectorAll(".ipd-only")
                        .forEach(x => x.style.display = "none");

                }

                const categories =
                    data.feedbackForm?.categories || [];
                window.categories = categories;
                const selectedMap = new Map();
                categories.forEach(c => {

                    (c.questions || []).forEach(q => {
                        if (q.selectedOptionIDF != null) {
                            const key = String(q.feedbackQuestionId);
                            if (!selectedMap.has(key))
                                selectedMap.set(key, []);
                            selectedMap
                                .get(key)
                                .push(String(q.selectedOptionIDF));

                        }

                    });

                });

                const container =
                    document.getElementById("questionContainer");
                container.innerHTML = "";

                let suggestionCat = null;
                let appreciationCat = null;
                let cardStagger = 0;

                const isQuestionCat = cat =>
                    cat.questions &&
                    cat.questions.length > 0 &&
                    !cat.questions.every(q => q.type === 2);

                const questionCatCount =
                    categories.filter(isQuestionCat).length;

                categories.forEach(cat => {

                    const isText = !isQuestionCat(cat);

                    if (isText) {

                        if (cat.categoryName?.toLowerCase().includes("suggest"))
                            suggestionCat = cat;

                        if (cat.categoryName?.toLowerCase().includes("appreciate"))
                            appreciationCat = cat;

                        return;
                    }

                    const section = document.createElement("div");
                    section.className = "section";

                    section.innerHTML =
                        questionCatCount > 1
                            ? `<div class="section-title">${cat.categoryName}</div>`
                            : "";

                    cat.questions.forEach((q, index) => {
                                       const card = document.createElement("div");
        card.className = "question-card";
        card.style.animationDelay = `${Math.min(cardStagger++, 8) * 0.06}s`;

        let html = "";

        const optionCount = (q.options || []).length;

        const isYesNo = optionCount === 0 && (q.type === 0 || q.type === 4);

        if (isYesNo) {
            const yesSelected = q.isSelected === true;
            const noSelected = q.isSelected === false;

            html += `
                <button
                    type="button"
                    class="${yesSelected ? "selected" : ""}"
                    data-qid="${q.feedbackQuestionId}"
                    data-cat="${cat.feedbackCategoryId}"
                    data-type="${q.type}"
                    data-answer="true"
                    onclick="selectOption(this)">
                    Yes
                </button>
                <button
                    type="button"
                    class="${noSelected ? "selected" : ""}"
                    data-qid="${q.feedbackQuestionId}"
                    data-cat="${cat.feedbackCategoryId}"
                    data-type="${q.type}"
                    data-answer="false"
                    onclick="selectOption(this)">
                    No
                </button>
            `;
        } else {
            (q.options || []).forEach(opt => {
                const qid = String(q.feedbackQuestionId);
                const optId = String(opt.feedbackOptionTypeId);
                const selected =
                    selectedMap.has(qid) &&
                    selectedMap.get(qid).includes(optId);

                html += `
                    <button
                        type="button"
                        class="${selected ? "selected" : ""}"
                        data-qid="${q.feedbackQuestionId}"
                        data-cat="${cat.feedbackCategoryId}"
                        data-type="${q.type}"
                        data-opt="${opt.feedbackOptionTypeId}"
                        onclick="selectOption(this)">
                        ${resolveOptionText(opt)}
                    </button>
                `;
            });
        }

        // Dynamic layout
        const layoutClass =
            isYesNo
                ? "rating-2"
                : (optionCount <= 4
                    ? `rating-${optionCount}`
                    : "rating-auto");

        card.innerHTML = `
            <div class="question-text">
                <span class="question-number">${index + 1}</span>
                <span class="question-label">${q.question}</span>
            </div>

            <div class="rating-row ${layoutClass}">
                ${html}
            </div>
        `;

        section.appendChild(card);
                    });
                    container.appendChild(section);

                });
                if (suggestionCat) {
                    container.insertAdjacentHTML(
                        "beforeend",
                        `
        <div class="section">
        <div class="section-title">
        ${suggestionCat.categoryName}
        </div>
        <div class="question-card">
        <textarea
        id="suggestionText"
        placeholder="Write your suggestions...">${suggestionCat.questions?.[0]?.textAnswer ?? ""}</textarea>
        </div>
        </div>`
                    );
                }

                if (appreciationCat) {

                    container.insertAdjacentHTML(
                        "beforeend",
                        `
        <div class="section">

        <div class="section-title">

        ${appreciationCat.categoryName}
        </div>
        <div class="question-card">
        <textarea
        id="appreciationText"
        placeholder="Write your appreciation...">${appreciationCat.questions?.[0]?.textAnswer ?? ""}</textarea>
        </div>
        </div>`
                    );

                }
                        document.getElementById("submitBtn").addEventListener("click", async () => {
            const categories = window.categories || [];

            const patientId = window.patientId;
            const registrationId = window.registrationId;
            const flag = window.flag;
            const isIpd = flag === 1;

            const details = [];

            let suggestionCat = null;
            let appreciationCat = null;

            categories.forEach(cat => {

                const isText =
                    !cat.questions ||
                    cat.questions.length === 0 ||
                    cat.questions.every(q => q.type === 2);

                if (isText) {

                    if (cat.categoryName?.toLowerCase().includes("suggest"))
                        suggestionCat = cat;

                    if (cat.categoryName?.toLowerCase().includes("appreciate"))
                        appreciationCat = cat;

                    return;
                }

                (cat.questions || []).forEach(q => {

                    if (q.type === 2) return;

                    const selectedBtn = document.querySelector(
                        `.rating-row button.selected[data-qid="${q.feedbackQuestionId}"]`
                    );

                    if (q.type === 0 || q.type === 4) {

                        details.push({
                            feedbackCategoryIDF: cat.feedbackCategoryId,
                            feedbackQuestionIDF: q.feedbackQuestionId,
                            selectedOptionIDF: null,
                            textAnswer: null,
                            type: q.type,
                            isSelected: selectedBtn
                                ? selectedBtn.dataset.answer === "true"
                                : false
                        });

                        return;
                    }

                    if (q.type === 1 || q.type === 3) {

                        (q.options || []).forEach(opt => {

                            details.push({

                                feedbackCategoryIDF: cat.feedbackCategoryId,
                                feedbackQuestionIDF: q.feedbackQuestionId,
                                selectedOptionIDF: opt.feedbackOptionTypeId,
                                textAnswer: null,
                                type: q.type,
                                isSelected:
                                    selectedBtn &&
                                    Number(selectedBtn.dataset.opt) === opt.feedbackOptionTypeId

                            });

                        });

                    }

                });

            });

            const suggestionText =
                (document.getElementById("suggestionText")?.value || "").trim();

            if (suggestionCat) {

                details.push({

                    feedbackCategoryIDF: suggestionCat.feedbackCategoryId,
                    feedbackQuestionIDF: null,
                    selectedOptionIDF: null,
                    textAnswer: suggestionText,
                    type: 2,
                    isSelected: true

                });

            }
            const appreciationText =
                (document.getElementById("appreciationText")?.value || "").trim();
            if (appreciationCat) {

                details.push({

                    feedbackCategoryIDF: appreciationCat.feedbackCategoryId,
                    feedbackQuestionIDF: null,
                    selectedOptionIDF: null,
                    textAnswer: appreciationText,
                    type: 2,
                    isSelected: true

                });

            }
            console.log(details);
            const payload = {
                token: window.feedbackToken,
                master: {

                    patientIDF: patientId,
                    registrationIDF: registrationId,
                    registrationCode: isIpd
                        ? (window._feedbackData?.ipdRegistrationCode || null)
                        : null,
                    registrationType: flag,
                    doctorIDF: window._feedbackData?.doctorIDF || 0,
                    remarks: ""

                },

                details: details

            };
            const btn = document.getElementById("submitBtn");
            btn.disabled = true;
            btn.innerHTML = "Submitting...";

            try {

                const saveRes = await fetch("/api/PatientFeedback/save", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"

                    },
                    body: JSON.stringify(payload)
                });

                if (!saveRes.ok) {
                    btn.disabled = false;
                    btn.innerHTML = "Submit Feedback";
                    alert(await saveRes.text());
                    return;

                }

                document.getElementById("formBody").style.display = "none";
                document.getElementById("successScreen").style.display = "flex";
                document.getElementById("subTitle").innerText = "Feedback submitted";
                document.getElementById("statusBadge").innerText = "Submitted";

            }
            catch (e) {

                console.error(e);
                btn.disabled = false;
                btn.innerHTML = "Submit Feedback";
                alert("Something went wrong while saving feedback.");
            }
        });

        }
        catch (err) {
            console.error(err);
            document.getElementById("submitBtn").disabled = true;
            alert(err.message || "Failed to load feedback.");

        }

        });

        function selectOption(btn) {
            const row = btn.parentElement;
            row.querySelectorAll("button").forEach(x =>
                x.classList.remove("selected"));
            btn.classList.add("selected");

        }
    </script>
</body>
</html>